# 复制成 .env 再填真实值。.env 已在 .gitignore 里，绝不要提交。
#
# 这些值只应该待在服务端。客户端（Flutter/APK）里永远不要出现密钥。

# 在 DeepSeek 后台重新生成后填这里（旧的泄露密钥请先作废）
DEEPSEEK_API_KEY=sk-your-new-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 单次调用模型的超时（秒）
DEEPSEEK_TIMEOUT=30

# 允许访问本服务的 bearer token，逗号分隔；客户端请求时要带 Authorization: Bearer <token>
# 留空 = 关闭鉴权（仅本地自测用，别带到线上）
ALLOWED_TOKENS=dev-token-1
